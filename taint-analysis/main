#!/usr/bin/env python3
"""
CLI entry point.

Usage: ./main -i path/to/test_dir
Prints exactly one JSON object on stdout, e.g. {"reaches": true}.
"""

import argparse
import json
import os
import sys

# the analysis package sits next to this script, not necessarily in the cwd
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from analysis.graph import load_case  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Static taint analyser.")
    parser.add_argument("-i", required=True, help="test case directory")
    args = parser.parse_args()

    graph, case = load_case(args.i)

    # TODO replace with the data-flow analysis
    reaches = False

    # stdout carries the JSON and nothing else
    print(json.dumps({"reaches": reaches}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
